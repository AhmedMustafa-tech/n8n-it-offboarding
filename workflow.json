      "id": "7faa2725-061e-4547-b1f4-1ca256e28a9a"
    },
    {
      "parameters": {
        "jsCode": "const c = $('Config').first().json;\nconst jc = $('JumpCloud: find user').first().json;\nconst found = (jc.results || [])[0];\nconst lines = [\n  `${c.DRY_RUN ? ':test_tube: DRY RUN' : ':white_check_mark: Offboarding complete'} for ${c.email}`,\n  `\u2022 Google Workspace: ${c.DRY_RUN ? 'would suspend' : 'suspended'}`,\n  `\u2022 JumpCloud: ${found ? (c.DRY_RUN ? 'would suspend ' : 'suspended ') + found.username : 'user not found'}`,\n  '\u2022 Still manual: collect laptop, transfer Drive ownership, remove non-SSO tools',\n];\nreturn [{ json: { text: lines.join('\\n'), channel: c.slackChannel, ticketKey: c.ticketKey, jiraBaseUrl: c.jiraBaseUrl } }];"
      },
      "name": "Build summary",
      "type": "n8n-nodes-base.code",
