    },
    {
      "parameters": {
        "jsCode": "// ===== EDIT THESE =====\n// Safety first: DRY_RUN = true only REPORTS what would happen. Set to false when you are ready.\nconst input = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  DRY_RUN: true,\n  email: input.email,                 // leaver's work email\n  ticketKey: input.ticketKey || '',   // optional Jira ticket to comment on\n  jiraBaseUrl: 'https://YOUR-SITE.atlassian.net',\n  slackChannel: '#offboarding-log',\n}}];"
      },
      "name": "Config",
      "type": "n8n-nodes-base.code",
